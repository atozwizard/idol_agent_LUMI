ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Upstage Solar API
# Get your key from: https://console.upstage.ai/
UPSTAGE_API_KEY=your_upstage_api_key
LLM_MODEL=solar-pro
ROUTER_LLM_MODEL=solar-mini

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# LangGraph checkpointer
# Use the PostgreSQL connection string from Supabase when CHECKPOINTER_TYPE=postgres.
SUPABASE_CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
ENABLE_CHECKPOINTER=true
CHECKPOINTER_TYPE=postgres

# Token and cost tracking
ENABLE_COST_TRACKING=true
DAILY_COST_LIMIT=1.0
MAX_CONTEXT_TOKENS=3000
DISCORD_WEBHOOK_URL=

# Langfuse observability
ENABLE_LANGFUSE=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_FLUSH_INTERVAL=5

# LiteLLM
USE_LITELLM=false
LITELLM_NUM_RETRIES=3
LITELLM_FALLBACK_MODEL=gemini/gemini-2.5-flash
LITELLM_TIMEOUT=10
GEMINI_API_KEY=

# Optional external APIs
OPENWEATHERMAP_API_KEY=
CITY_NAME=서울
